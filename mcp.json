{
  "mcpServers": {
    "nasir-al-din-al-tusi-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "TITAN_PROTOCOL": "TUSI",
        "TARGET_CHAIN": "Solana",
        "FIPS_203_LEVEL": "ML-KEM-768",
        "FIPS_204_LEVEL": "ML-DSA-65"
      },
      "tools": [
        {
          "name": "verify_nasir_al_din_al_tusi_discovery",
          "description": "Verifies core invariant principles: Created Tusi couple geometrical technique, non-Ptolemaic planetary motion models",
          "parameters": {
            "type": "object",
            "properties": {
              "input_data": {
                "type": "string"
              },
              "precision_level": {
                "type": "integer"
              }
            },
            "required": [
              "input_data"
            ]
          }
        },
        {
          "name": "model_nasir_al_din_al_tusi_telemetry",
          "description": "Models high-assurance domain telemetry for Astronomy & Mathematics",
          "parameters": {
            "type": "object",
            "properties": {
              "telemetry_vector": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "telemetry_vector"
            ]
          }
        }
      ]
    }
  }
}